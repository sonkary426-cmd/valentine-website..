<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>For Somu ❤️</title>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Poppins:wght@400;500;600;700&display=swap');

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
      overflow: hidden;
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #ffd6e5, #ff8fab, #ffb3c6);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    .container {
      width: min(90%, 600px);
      text-align: center;
      position: relative;
      z-index: 10;
      padding: 30px 20px;
    }

    .bear {
      font-size: clamp(60px, 15vw, 100px);
      animation: bounce 1.5s ease-in-out infinite;
      margin-bottom: 10px;
      display: inline-block;
    }

    @keyframes bounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-20px); }
    }

    h1 {
      font-family: 'Dancing Script', cursive;
      font-size: clamp(40px, 9vw, 70px);
      line-height: 1.1;
      color: #a5002b;
      margin-bottom: 18px;
      text-shadow: 0 4px 15px rgba(130, 0, 40, 0.15);
    }

    .subtitle {
      font-size: clamp(15px, 4vw, 19px);
      font-style: italic;
      color: #6d1935;
      margin-bottom: 35px;
    }

    .buttons {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 50px;
      position: relative;
      min-height: 70px;
    }

    button {
      font-family: 'Poppins', sans-serif;
      cursor: pointer;
      font-size: 18px;
      font-weight: 600;
      transition: 0.25s ease;
      touch-action: manipulation;
    }

    #yesBtn {
      border: none;
      color: white;
      padding: 17px 42px;
      border-radius: 50px;
      background: linear-gradient(135deg, #e00046, #ff174f, #c70039);
      box-shadow: 0 8px 25px rgba(190, 0, 60, 0.35);
      position: relative;
      z-index: 20;
    }

    #yesBtn:hover {
      transform: scale(1.08);
      box-shadow:
        0 0 15px #ff174f,
        0 0 35px rgba(255, 23, 79, 0.6);
    }

    #noBtn {
      background: white;
      color: #d0003b;
      border: 3px solid #d0003b;
      padding: 11px 27px;
      border-radius: 50px;
      z-index: 30;
      white-space: nowrap;
    }

    #noBtn:hover {
      background: #fff0f4;
    }

    .closing {
      margin-top: 40px;
      color: #73132f;
      font-family: 'Dancing Script', cursive;
      font-size: clamp(21px, 5vw, 30px);
    }

    /* Floating hearts */
    .hearts {
      position: fixed;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
      z-index: 1;
    }

    .heart {
      position: absolute;
      bottom: -60px;
      animation: floatHeart linear infinite;
      opacity: 0;
      user-select: none;
    }

    @keyframes floatHeart {
      0% {
        transform: translateY(0) rotate(0deg);
        opacity: 0;
      }

      10% { opacity: 0.8; }
      50% { opacity: 1; }
      90% { opacity: 0.7; }

      100% {
        transform: translateY(-115vh) rotate(360deg);
        opacity: 0;
      }
    }

    /* Celebration */
    #celebration {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 100;
      background: linear-gradient(135deg, #ffb3c6, #ff6f91, #ffccd9);
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 20px;
    }

    .celebration-content {
      position: relative;
      z-index: 110;
    }

    .yay {
      font-family: 'Dancing Script', cursive;
      font-size: clamp(70px, 18vw, 130px);
      color: #a5002b;
      animation: pulse 0.9s ease-in-out infinite;
    }

    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.12); }
    }

    .spinning-heart {
      font-size: clamp(55px, 13vw, 90px);
      display: inline-block;
      animation: spin 2s linear infinite;
      margin: 10px 0 20px;
    }

    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    .celebration-message {
      color: #73132f;
      font-size: clamp(20px, 5vw, 30px);
      font-weight: 600;
    }

    /* Confetti */
    .confetti-container {
      position: fixed;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
      z-index: 105;
    }

    .confetti {
      position: absolute;
      top: 45%;
      left: 50%;
      width: 10px;
      height: 16px;
      animation: explode 2.5s ease-out forwards;
    }

    @keyframes explode {
      0% {
        transform: translate(-50%, -50%) rotate(0deg);
        opacity: 1;
      }

      100% {
        transform:
          translate(
            calc(-50% + var(--x)),
            calc(-50% + var(--y))
          )
          rotate(var(--rotation));
        opacity: 0;
      }
    }

    .popup {
      position: fixed;
      left: 50%;
      top: 15%;
      transform: translateX(-50%);
      background: white;
      color: #b00038;
      padding: 10px 18px;
      border-radius: 30px;
      font-size: 14px;
      font-weight: 600;
      box-shadow: 0 5px 20px rgba(100, 0, 30, 0.15);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s;
      z-index: 90;
    }

    .popup.show {
      opacity: 1;
    }

    @media (max-width: 500px) {
      .buttons {
        gap: 45px;
      }

      #yesBtn {
        padding: 15px 32px;
        font-size: 16px;
      }

      #noBtn {
        padding: 9px 20px;
        font-size: 15px;
      }
    }
  </style>
</head>

<body>

  <div class="hearts" id="hearts"></div>

  <main class="container" id="proposal">

    <div class="bear">🧸</div>

    <h1>
      Will You Be My Valentine,<br>
      Somu? ❤️
    </h1>

    <p class="subtitle">
      Every moment with you feels a little more special...
    </p>

    <div class="buttons">
      <button id="yesBtn">Yes ❤️</button>
      <button id="noBtn">No</button>
    </div>

    <p class="closing">
      Every love story is beautiful, but ours is my favourite
    </p>

  </main>

  <section id="celebration">

    <div class="celebration-content">

      <div class="yay">Yayyyy!!</div>

      <div class="spinning-heart">💖</div>

      <p class="celebration-message">
        I knew you'd say yes, Somu... ❤️
      </p>

    </div>

    <div class="confetti-container" id="confetti"></div>

  </section>

  <div class="popup" id="popup"></div>

  <script>

    /* FLOATING HEARTS */

    const heartsContainer =
      document.getElementById("hearts");

    const heartEmojis = [
      "❤️", "💖", "💕", "💗", "💓", "💘"
    ];

    function createHeart() {

      const heart = document.createElement("div");

      heart.className = "heart";

      heart.textContent =
        heartEmojis[
          Math.floor(Math.random() * heartEmojis.length)
        ];

      const size = Math.random() * 25 + 15;
      const left = Math.random() * 100;
      const duration = Math.random() * 5 + 6;
      const delay = Math.random() * 3;

      heart.style.left = left + "%";
      heart.style.fontSize = size + "px";
      heart.style.animationDuration = duration + "s";
      heart.style.animationDelay = delay + "s";

      heartsContainer.appendChild(heart);

      setTimeout(() => {
        heart.remove();
      }, (duration + delay) * 1000 + 1000);
    }

    for (let i = 0; i < 15; i++) {
      createHeart();
    }

    const heartInterval =
      setInterval(createHeart, 700);


    /* RUNAWAY NO BUTTON */

    const noBtn =
      document.getElementById("noBtn");

    const yesBtn =
      document.getElementById("yesBtn");

    const popup =
      document.getElementById("popup");

    const cheekyMessages = [
      "Nope, not an option!",
      "Try again!",
      "You sure about that?",
      "Not happening!",
      "Think again!"
    ];

    let messageIndex = 0;

    function moveNoButton() {

      const buttonWidth = noBtn.offsetWidth;
      const buttonHeight = noBtn.offsetHeight;

      const yesRect =
        yesBtn.getBoundingClientRect();

      const padding = 15;

      let x;
      let y;
      let safe = false;

      for (let attempt = 0; attempt < 100; attempt++) {

        x =
          Math.random() *
          (window.innerWidth - buttonWidth - padding * 2)
          + padding;

        y =
          Math.random() *
          (window.innerHeight - buttonHeight - padding * 2)
          + padding;

        const noRight = x + buttonWidth;
        const noBottom = y + buttonHeight;

        const overlapsYes =
          noRight + 20 > yesRect.left &&
          x - 20 < yesRect.right &&
          noBottom + 20 > yesRect.top &&
          y - 20 < yesRect.bottom;

        if (!overlapsYes) {
          safe = true;
          break;
        }
      }

      if (!safe) {
        x = padding;
        y = padding;
      }

      noBtn.style.position = "fixed";
      noBtn.style.left = x + "px";
      noBtn.style.top = y + "px";

      showCheekyMessage();
    }

    function showCheekyMessage() {

      popup.textContent =
        cheekyMessages[messageIndex];

      messageIndex =
        (messageIndex + 1) % cheekyMessages.length;

      popup.classList.add("show");

      setTimeout(() => {
        popup.classList.remove("show");
      }, 1000);
    }

    noBtn.addEventListener(
      "mouseenter",
      moveNoButton
    );

    noBtn.addEventListener(
      "click",
      function(event) {
        event.preventDefault();
        moveNoButton();
      }
    );

    noBtn.addEventListener(
      "touchstart",
      function(event) {
        event.preventDefault();
        moveNoButton();
      },
      { passive: false }
    );


    /* YES BUTTON */

    yesBtn.addEventListener(
      "click",
      celebrate
    );

    function celebrate() {

      document.getElementById(
        "proposal"
      ).style.display = "none";

      noBtn.style.display = "none";

      clearInterval(heartInterval);

      heartsContainer.innerHTML = "";

      const celebration =
        document.getElementById("celebration");

      celebration.style.display = "flex";

      createConfetti();
    }


    /* 120 CONFETTI */

    function createConfetti() {

      const container =
        document.getElementById("confetti");

      const colors = [
        "#ff174f",
        "#ff4081",
        "#ffd600",
        "#00c853",
        "#2979ff",
        "#aa00ff",
        "#ff6d00"
      ];

      for (let i = 0; i < 120; i++) {

        const piece =
          document.createElement("div");

        piece.className = "confetti";

        const angle =
          Math.random() * Math.PI * 2;

        const distance =
          150 + Math.random() * 500;

        const x =
          Math.cos(angle) * distance;

        const y =
          Math.sin(angle) * distance;

        const rotation =
          Math.random() * 1080 - 540;

        const size =
          Math.random() * 8 + 5;

        piece.style.width =
          size + "px";

        piece.style.height =
          Math.random() * 12 + 7 + "px";

        piece.style.setProperty(
          "--x",
          x + "px"
        );

        piece.style.setProperty(
          "--y",
          y + "px"
        );

        piece.style.setProperty(
          "--rotation",
          rotation + "deg"
        );

        piece.style.background =
          colors[
            Math.floor(Math.random() * colors.length)
          ];

        piece.style.animationDelay =
          Math.random() * 0.3 + "s";

        container.appendChild(piece);
      }
    }

  </script>

</body>
</html>